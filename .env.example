# Copy this file to .env and fill in your own values, then restart the server.
# .env is already in .gitignore — never commit real keys.

# Required for the "Generate my site" button (server/generate.js).
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — override the model(s) BrixOS uses for site generation.
# Both default to claude-sonnet-4-5-20250929 if unset. Check
# https://docs.claude.com/en/docs/about-claude/models for current model
# identifiers before changing these (Anthropic ships new versions over time).
# BRIXOS_MODEL=
# BRIXOS_PLANNER_MODEL=
# BRIXOS_BUILDER_MODEL=

# A long random string — used to sign session cookies. Ships with an obvious
# placeholder default; set a real one before exposing this beyond localhost.
SESSION_SECRET=

# Optional — defaults to 3000.
PORT=
