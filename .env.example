# Copy this file to .env and fill in your own values, then restart the server.
# .env is already in .gitignore — never commit real keys.

# BrixOS needs ONE of these two to run the real AI agents (chat, Planner,
# Builder — see server/llm.js). Without either, the app still runs, just on
# a rule-based local fallback (server/*Local functions) instead of a real
# model. If both are set, Anthropic is used.

# Option A — direct Anthropic access. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B — OpenRouter (https://openrouter.ai), which fronts many providers'
# models behind one API, including some genuinely free ones — handy if you
# don't have (or don't want to pay for) a direct Anthropic key yet. Get a key
# from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — pin an exact OpenRouter model id (e.g. "meta-llama/llama-3.3-70b-instruct:free").
# If unset, BrixOS asks OpenRouter's own model list at startup for whichever
# free-tier model looks most capable and supports tool calling, and uses
# that automatically — the console logs which one it picked. Browse
# https://openrouter.ai/models?max_price=0 to pick one yourself if you'd
# rather pin it.
# OPENROUTER_MODEL=

# Optional — override the model(s) BrixOS uses for site generation when
# using the Anthropic path. All default to claude-sonnet-4-5-20250929 if
# unset. Check https://docs.claude.com/en/docs/about-claude/models for
# current model identifiers before changing these (Anthropic ships new
# versions over time).
# BRIXOS_MODEL=
# BRIXOS_PLANNER_MODEL=
# BRIXOS_BUILDER_MODEL=
# BRIXOS_CHAT_MODEL=

# A long random string — used to sign session cookies. Ships with an obvious
# placeholder default; set a real one before exposing this beyond localhost.
SESSION_SECRET=

# Optional — defaults to 3000.
PORT=
