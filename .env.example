# Copy this file to .env and fill in your own values, then restart the server.
# .env is already in .gitignore — never commit real keys.

# BrixOS needs ONE of these two to run the real AI agents (chat, Planner,
# Builder — see server/llm.js). Without either, the app still runs, just on
# a rule-based local fallback (server/*Local functions) instead of a real
# model. If both are set, Anthropic is used.

# Option A — direct Anthropic access. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B — OpenRouter (https://openrouter.ai), which fronts many providers'
# models behind one API, including some genuinely free ones — handy if you
# don't have (or don't want to pay for) a direct Anthropic key yet. Get a key
# from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — Groq (https://console.groq.com/keys, free, no card required).
# OpenRouter's free (":free") models share ONE account-wide "requests per
# day" cap across every free model — a busy day can burn through the whole
# quota, and every free-tier call then fails with the same rate-limit error
# until it resets. Groq has its own separate free-tier quota, so when this
# is set BrixOS automatically falls back to it the moment OpenRouter's free
# tier is unavailable (empty replies, errors, or the daily cap). Not a
# provider you pick — purely an automatic safety net alongside OPENROUTER_API_KEY.
GROQ_API_KEY=

# Optional — pin an exact Groq model id (e.g. "llama-3.3-70b-versatile").
# If unset, BrixOS tries "llama-3.3-70b-versatile" then "llama-3.1-8b-instant".
# GROQ_MODEL=

# Optional — Gemini (https://aistudio.google.com/apikey, free, no card
# required), a THIRD independent free-tier provider, reached through
# Google's own OpenAI-compatibility endpoint. Same idea as GROQ_API_KEY:
# a separate account-wide quota from both OpenRouter's and Groq's, so it's
# one more automatic fallback if both of those are unavailable. Not a
# provider you pick — purely a safety net alongside the other two.
GEMINI_API_KEY=

# Optional — pin an exact Gemini model id (e.g. "gemini-2.5-flash").
# If unset, BrixOS tries "gemini-2.5-flash" then "gemini-2.5-flash-lite".
# GEMINI_MODEL=

# Optional — pin an exact OpenRouter model id (e.g. "meta-llama/llama-3.3-70b-instruct:free").
# If unset, BrixOS asks OpenRouter's own model list at startup for whichever
# free-tier model looks most capable and supports tool calling, and uses
# that automatically — the console logs which one it picked. Browse
# https://openrouter.ai/models?max_price=0 to pick one yourself if you'd
# rather pin it.
# OPENROUTER_MODEL=

# Optional — override the model(s) BrixOS uses for site generation when
# using the Anthropic path. All default to claude-sonnet-4-5-20250929 if
# unset. Check https://docs.claude.com/en/docs/about-claude/models for
# current model identifiers before changing these (Anthropic ships new
# versions over time).
# BRIXOS_MODEL=
# BRIXOS_PLANNER_MODEL=
# BRIXOS_BUILDER_MODEL=
# BRIXOS_CHAT_MODEL=

# A long random string — used to sign session cookies. Ships with an obvious
# placeholder default; set a real one before exposing this beyond localhost.
SESSION_SECRET=

# Optional — defaults to 3000.
PORT=

# ---------------------------------------------------------------------------
# BrixOS Orchestrator (server/orchestrator.js) — see README.md's "The BrixOS
# Orchestrator" section. Uses the same ANTHROPIC_API_KEY/OPENROUTER_API_KEY
# above (Claude for reasoning/planning, OpenRouter for generation) — nothing
# extra to configure to turn it on. Both vars below are optional.
# ---------------------------------------------------------------------------

# How many times the orchestrator will send a generated page back to the
# generation worker for a fix if it fails validation (missing doctype/title/
# viewport, unbalanced tags, missing planned sections, ...) before giving up
# and showing the best attempt it got. Defaults to 3.
# MAX_GENERATION_ITERATIONS=

# How many pages the orchestrator generates at once (bounded concurrency —
# independent pages don't need to wait on each other). Defaults to 3.
# ORCHESTRATOR_CONCURRENCY=
